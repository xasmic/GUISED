{% comment %} Activate account — Hygen {% endcomment %}
<section class="hygen-account">
  <div class="hygen-account__inner">
    <p class="hygen-account__eyebrow">Account</p>
    <h1 class="hygen-account__title">Activate account</h1>

    {% form 'activate_customer_password', class: 'hygen-account__form' %}
      {% if form.errors %}
        <p class="hygen-account__error" role="alert">{{ form.errors | default_errors }}</p>
      {% endif %}

      <label class="hygen-account__label" for="Password">Password</label>
      <input id="Password" class="hygen-account__input" type="password" name="customer[password]" required>

      <label class="hygen-account__label" for="PasswordConfirm">Confirm password</label>
      <input id="PasswordConfirm" class="hygen-account__input" type="password" name="customer[password_confirmation]" required>

      <button type="submit" class="hygen-account__submit">
        Activate account
        <span aria-hidden="true"></span>
      </button>
    {% endform %}
  </div>
</section>
