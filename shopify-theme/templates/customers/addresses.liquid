{% comment %} Customer addresses — Hygen {% endcomment %}
<section class="hygen-account">
  <div class="hygen-account__inner hygen-account__inner--wide">
    <p class="hygen-account__eyebrow">Account</p>
    <h1 class="hygen-account__title">Addresses</h1>

    {% if customer.addresses.size > 0 %}
      <ul class="hygen-account__addresses">
        {% for address in customer.addresses %}
          <li class="hygen-account__address">
            {{ address | format_address }}
            {% if address == customer.default_address %}
              <p class="hygen-account__meta">Default</p>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="hygen-account__empty">No addresses saved yet.</p>
    {% endif %}

    <h2 class="hygen-account__subtitle">Add address</h2>
    {% form 'customer_address', customer.new_address, class: 'hygen-account__form' %}
      <label class="hygen-account__label" for="AddressFirstName">First name</label>
      <input id="AddressFirstName" class="hygen-account__input" type="text" name="address[first_name]" autocomplete="given-name">

      <label class="hygen-account__label" for="AddressLastName">Last name</label>
      <input id="AddressLastName" class="hygen-account__input" type="text" name="address[last_name]" autocomplete="family-name">

      <label class="hygen-account__label" for="AddressAddress1">Address</label>
      <input id="AddressAddress1" class="hygen-account__input" type="text" name="address[address1]" autocomplete="address-line1">

      <label class="hygen-account__label" for="AddressCity">City</label>
      <input id="AddressCity" class="hygen-account__input" type="text" name="address[city]" autocomplete="address-level2">

      <label class="hygen-account__label" for="AddressCountry">Country</label>
      <input id="AddressCountry" class="hygen-account__input" type="text" name="address[country]" autocomplete="country-name">

      <label class="hygen-account__label" for="AddressZip">Postal code</label>
      <input id="AddressZip" class="hygen-account__input" type="text" name="address[zip]" autocomplete="postal-code">

      <button type="submit" class="hygen-account__submit">
        Save address
        <span aria-hidden="true"></span>
      </button>
    {% endform %}

    <p class="hygen-account__links">
      <a href="{{ routes.account_url }}">Back to account</a>
    </p>
  </div>
</section>
