{%- liquid
  assign left_url = section.settings.left_image_url
  assign right_url = section.settings.right_image_url
  if left_url == blank
    assign left_url = 'hygen-about-left.png' | asset_url
  endif
  if right_url == blank
    assign right_url = 'hygen-about-right.png' | asset_url
  endif
-%}

<section class="hygen-about" id="about">
  <div class="hygen-about__split" aria-hidden="true">
    <div class="hygen-about__panel hygen-about__panel--left">
      {% if section.settings.left_image != blank %}
        {{
          section.settings.left_image
          | image_url: width: 2400
          | image_tag: loading: 'lazy', class: 'hygen-about__img hygen-about__img--mono', alt: section.settings.left_image.alt | default: 'Atelier craft'
        }}
      {% else %}
        <img class="hygen-about__img hygen-about__img--mono" src="{{ left_url }}" alt="Atelier craft" loading="lazy" width="1200" height="1600">
      {% endif %}
    </div>
    <div class="hygen-about__panel hygen-about__panel--right">
      {% if section.settings.right_image != blank %}
        {{
          section.settings.right_image
          | image_url: width: 2400
          | image_tag: loading: 'lazy', class: 'hygen-about__img', alt: section.settings.right_image.alt | default: 'Leather in wear'
        }}
      {% else %}
        <img class="hygen-about__img" src="{{ right_url }}" alt="Leather in wear" loading="lazy" width="1200" height="1600">
      {% endif %}
    </div>
  </div>

  <div class="hygen-about__veil"></div>

  <div class="hygen-about__copy">
    <div class="hygen-about__copy-inner">
      <h2 class="hygen-about__headline">
        {{ section.settings.headline | default: 'Redefining Leathercraft' }}
      </h2>
      {% if section.settings.paragraph_1 != blank %}
        <p class="hygen-about__body">{{ section.settings.paragraph_1 }}</p>
      {% endif %}
      {% if section.settings.paragraph_2 != blank %}
        <p class="hygen-about__body">{{ section.settings.paragraph_2 }}</p>
      {% endif %}
      {% if section.settings.paragraph_3 != blank %}
        <p class="hygen-about__body">{{ section.settings.paragraph_3 }}</p>
      {% endif %}
      {% if section.settings.paragraph_4 != blank %}
        <p class="hygen-about__body">{{ section.settings.paragraph_4 }}</p>
      {% endif %}
      {% if section.settings.paragraph_5 != blank %}
        <p class="hygen-about__body">{{ section.settings.paragraph_5 }}</p>
      {% endif %}
      {%- liquid
        assign about_cta_label = section.settings.cta_label | default: 'Read our story'
        assign about_cta_url = section.settings.cta_link
        if about_cta_url == blank
          assign about_cta_url = pages.about.url | default: '/pages/about'
        endif
      -%}
      {% if about_cta_label != blank and about_cta_url != blank %}
        <a class="hygen-about__cta" href="{{ about_cta_url }}">
          {{ about_cta_label }}
          <span aria-hidden="true"></span>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hygen about",
  "tag": "section",
  "class": "hygen-section-about",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Redefining Leathercraft"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "At Guised, leather is a medium of expression. Every piece is obsessively crafted by hand with the intention of challenging conventional ideas of traditional leathercraft. No two pieces are ever the same, designed to evolve with their owner and reflect their story."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2"
    },
    {
      "type": "textarea",
      "id": "paragraph_3",
      "label": "Paragraph 3"
    },
    {
      "type": "textarea",
      "id": "paragraph_4",
      "label": "Paragraph 4"
    },
    {
      "type": "textarea",
      "id": "paragraph_5",
      "label": "Paragraph 5"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link",
      "info": "Defaults to the About page"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left image"
    },
    {
      "type": "text",
      "id": "left_image_url",
      "label": "Left image URL (blank = theme asset)"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right image"
    },
    {
      "type": "text",
      "id": "right_image_url",
      "label": "Right image URL (blank = theme asset)"
    }
  ],
  "presets": [{ "name": "Hygen about" }]
}
{% endschema %}
