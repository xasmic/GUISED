{%- liquid
  assign left_url = section.settings.left_image_url
  assign right_url = section.settings.right_image_url
  if left_url == blank
    assign left_url = 'hygen-about-left.png' | asset_url
  endif
  if right_url == blank
    assign right_url = 'hygen-about-right.png' | asset_url
  endif
-%}

<section class="hygen-about" id="about">
  <div class="hygen-about__split" aria-hidden="true">
    <div class="hygen-about__panel hygen-about__panel--left">
      {% if section.settings.left_image != blank %}
        {{
          section.settings.left_image
          | image_url: width: 1800
          | image_tag: loading: 'lazy', class: 'hygen-about__img hygen-about__img--mono', alt: ''
        }}
      {% else %}
        <img class="hygen-about__img hygen-about__img--mono" src="{{ left_url }}" alt="" loading="lazy" width="1200" height="1600">
      {% endif %}
    </div>
    <div class="hygen-about__panel hygen-about__panel--right">
      {% if section.settings.right_image != blank %}
        {{
          section.settings.right_image
          | image_url: width: 1800
          | image_tag: loading: 'lazy', class: 'hygen-about__img', alt: ''
        }}
      {% else %}
        <img class="hygen-about__img" src="{{ right_url }}" alt="" loading="lazy" width="1200" height="1600">
      {% endif %}
    </div>
  </div>

  <div class="hygen-about__veil"></div>

  <div class="hygen-about__copy">
    <div class="hygen-about__copy-inner">
      <h2 class="hygen-about__headline">
        {{ section.settings.headline | default: 'Buy a piece for a lifetime' }}
      </h2>
      {% if section.settings.paragraph_1 != blank %}
        <p class="hygen-about__body">{{ section.settings.paragraph_1 }}</p>
      {% endif %}
      {% if section.settings.paragraph_2 != blank %}
        <p class="hygen-about__body">{{ section.settings.paragraph_2 }}</p>
      {% endif %}
      {% if section.settings.paragraph_3 != blank %}
        <p class="hygen-about__body">{{ section.settings.paragraph_3 }}</p>
      {% endif %}
      {% if section.settings.paragraph_4 != blank %}
        <p class="hygen-about__body">{{ section.settings.paragraph_4 }}</p>
      {% endif %}
      {% if section.settings.paragraph_5 != blank %}
        <p class="hygen-about__body">{{ section.settings.paragraph_5 }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hygen about",
  "tag": "section",
  "class": "hygen-section-about",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Buy a piece for a lifetime"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "All of our leathers are hides taken with intent, never exploitation — sourced from tanneries we know, trust, and hold to the same standard we hold ourselves."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "Each Guised piece begins as horse culatta: a dense, unruly hide scarred by the life it once carried. No two panels share a memory."
    },
    {
      "type": "textarea",
      "id": "paragraph_3",
      "label": "Paragraph 3",
      "default": "Pale and waxen at first, it darkens the longer it is touched — its fibres swelling, compressing, hardening into a second skin shaped by your habits alone. This is not leather that resists wear. It feeds on it. Every crease is a record. Every mark, a quiet confession between you and the hide."
    },
    {
      "type": "textarea",
      "id": "paragraph_4",
      "label": "Paragraph 4"
    },
    {
      "type": "textarea",
      "id": "paragraph_5",
      "label": "Paragraph 5"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left image"
    },
    {
      "type": "text",
      "id": "left_image_url",
      "label": "Left image URL (blank = theme asset)",
      "default": ""
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right image"
    },
    {
      "type": "text",
      "id": "right_image_url",
      "label": "Right image URL (blank = theme asset)",
      "default": ""
    }
  ],
  "presets": [{ "name": "Hygen about" }]
}
{% endschema %}
