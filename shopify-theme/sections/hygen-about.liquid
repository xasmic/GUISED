<section class="hygen-about" id="about">
  {% render 'hygen-nav', active: 'about' %}

  <div class="hygen-about__inner">
    <div class="hygen-about__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag: loading: 'lazy', class: 'hygen-about__img', alt: section.settings.image.alt | default: section.settings.title
        }}
      {% else %}
        <img
          class="hygen-about__img"
          src="{{ section.settings.image_url }}"
          alt="{{ section.settings.title | escape }}"
          loading="lazy"
          width="700"
          height="933"
        >
      {% endif %}
    </div>

    <div class="hygen-about__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="hygen-about__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="hygen-about__title">{{ section.settings.title }}</h2>
      {% if section.settings.body != blank %}
        <div class="hygen-about__body">{{ section.settings.body }}</div>
      {% endif %}
      {% if section.settings.body_secondary != blank %}
        <div class="hygen-about__secondary">{{ section.settings.body_secondary }}</div>
      {% endif %}

      <dl class="hygen-about__meta">
        {% if section.settings.detail_1_label != blank %}
          <div>
            <dt>{{ section.settings.detail_1_label }}</dt>
            <dd>{{ section.settings.detail_1_value }}</dd>
          </div>
        {% endif %}
        {% if section.settings.detail_2_label != blank %}
          <div>
            <dt>{{ section.settings.detail_2_label }}</dt>
            <dd>{{ section.settings.detail_2_value }}</dd>
          </div>
        {% endif %}
        {% if section.settings.detail_3_label != blank %}
          <div>
            <dt>{{ section.settings.detail_3_label }}</dt>
            <dd>{{ section.settings.detail_3_value }}</dd>
          </div>
        {% endif %}
      </dl>

      {% if section.settings.link != blank %}
        <a class="hygen-about__link" href="{{ section.settings.link }}">
          {{ section.settings.link_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hygen about",
  "tag": "section",
  "class": "hygen-section-about",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The atelier"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "About"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "GUISED is a Singapore leather atelier making goods meant to be lived in — cut, burnished, and finished by hand so each piece carries the marks of its making."
    },
    {
      "type": "textarea",
      "id": "body_secondary",
      "label": "Secondary body",
      "default": "We work slowly: culatta, belts, wallets, bags. Made to order when needed. Built to age with you, not against you."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (optional override)"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL",
      "default": "https://atelierguised.com/cdn/shop/files/Guised-02087_SHOPIFY_CROP.jpg?v=1761817097&width=2000"
    },
    {
      "type": "text",
      "id": "detail_1_label",
      "label": "Detail 1 label",
      "default": "Based in"
    },
    {
      "type": "text",
      "id": "detail_1_value",
      "label": "Detail 1 value",
      "default": "Singapore"
    },
    {
      "type": "text",
      "id": "detail_2_label",
      "label": "Detail 2 label",
      "default": "Practice"
    },
    {
      "type": "text",
      "id": "detail_2_value",
      "label": "Detail 2 value",
      "default": "Handcrafted leather goods"
    },
    {
      "type": "text",
      "id": "detail_3_label",
      "label": "Detail 3 label",
      "default": "Ethos"
    },
    {
      "type": "text",
      "id": "detail_3_value",
      "label": "Detail 3 value",
      "default": "Evolving through imperfections"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Read more link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Read more label",
      "default": "Read more"
    }
  ],
  "presets": [{ "name": "Hygen about" }]
}
{% endschema %}
