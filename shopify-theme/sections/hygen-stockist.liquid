<section class="hygen-stockist" id="stockist">
  <div class="hygen-stockist__inner">
    <div class="hygen-stockist__intro">
      <p class="hygen-stockist__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="hygen-stockist__title">{{ section.settings.title }}</h2>
      <p class="hygen-stockist__lede">{{ section.settings.lede }}</p>
    </div>

    <div class="hygen-stockist__grid">
      {% for block in section.blocks %}
        {% if block.type == 'region' %}
          <div class="hygen-stockist__col" {{ block.shopify_attributes }}>
            <div class="hygen-stockist__col-head">
              <h3 class="hygen-stockist__region">{{ block.settings.region }}</h3>
              {% if block.settings.show_instagram and block.settings.instagram_url != blank %}
                <a
                  class="hygen-stockist__instagram"
                  href="{{ block.settings.instagram_url }}"
                  target="_blank"
                  rel="noreferrer"
                  aria-label="GUISED on Instagram"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" stroke="currentColor" stroke-width="1.5"></rect>
                    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"></circle>
                    <circle cx="17.2" cy="6.8" r="1" fill="currentColor"></circle>
                  </svg>
                </a>
              {% endif %}
            </div>

            <div class="hygen-stockist__entry">
              {% if block.settings.href != blank %}
                <a class="hygen-stockist__name" href="{{ block.settings.href }}" target="_blank" rel="noreferrer">
                  {{ block.settings.store_name }}
                </a>
              {% else %}
                <p class="hygen-stockist__name">{{ block.settings.store_name }}</p>
              {% endif %}

              {% if block.settings.address_line_1 != blank %}
                <p class="hygen-stockist__detail">{{ block.settings.address_line_1 }}</p>
              {% endif %}
              {% if block.settings.address_line_2 != blank %}
                <p class="hygen-stockist__detail">{{ block.settings.address_line_2 }}</p>
              {% endif %}
              {% if block.settings.note != blank %}
                <p class="hygen-stockist__detail">{{ block.settings.note }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hygen stockist",
  "tag": "section",
  "class": "hygen-section-stockist",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Stockists"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Where to find us"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Description",
      "default": "Visit our Singapore stockist, or order online for international shipping."
    }
  ],
  "blocks": [
    {
      "type": "region",
      "name": "Region",
      "settings": [
        { "type": "text", "id": "region", "label": "Region", "default": "Singapore" },
        { "type": "text", "id": "store_name", "label": "Store name", "default": "Upstairs Garments" },
        { "type": "text", "id": "address_line_1", "label": "Address line 1" },
        { "type": "text", "id": "address_line_2", "label": "Address line 2" },
        { "type": "text", "id": "note", "label": "Note" },
        { "type": "url", "id": "href", "label": "Link" },
        {
          "type": "checkbox",
          "id": "show_instagram",
          "label": "Show Instagram icon",
          "default": false
        },
        { "type": "url", "id": "instagram_url", "label": "Instagram URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hygen stockist",
      "blocks": [
        {
          "type": "region",
          "settings": {
            "region": "Singapore",
            "store_name": "Upstairs Garments",
            "address_line_1": "75 Tanjong Pagar Road",
            "address_line_2": "Singapore"
          }
        },
        {
          "type": "region",
          "settings": {
            "region": "Online",
            "store_name": "Online store",
            "note": "Worldwide shipping",
            "href": "/",
            "show_instagram": true,
            "instagram_url": "https://www.instagram.com/___guised"
          }
        }
      ]
    }
  ]
}
{% endschema %}
