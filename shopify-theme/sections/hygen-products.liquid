<section class="hygen-products">
  <div class="hygen-products__inner">
    <header class="hygen-products__header">
      <p class="hygen-products__eyebrow">Archive</p>
      <h1 class="hygen-products__title">Online Store</h1>
    </header>

    {%- liquid
      assign current_sort = collection.sort_by | default: collection.default_sort_by
      if current_sort == blank
        assign current_sort = 'manual'
      endif
    -%}

    <div class="hygen-products__toolbar" data-hygen-products-toolbar>
      <div class="hygen-products__toolbar-row">
        <button
          type="button"
          class="hygen-products__filter-btn"
          data-hygen-filter-toggle
          aria-expanded="false"
          aria-controls="hygen-products-filter-drawer"
        >
          <span class="hygen-products__filter-label">Filter</span>
          <span class="hygen-products__filter-icon" aria-hidden="true" data-hygen-filter-icon>+</span>
        </button>

        <label class="hygen-products__sort">
          <span class="hygen-products__sort-label">Sort by</span>
          <select
            class="hygen-products__sort-select"
            data-hygen-sort-select
            aria-label="Sort products"
          >
            <option value="manual"{% if current_sort == 'manual' %} selected{% endif %}>Featured</option>
            <option value="best-selling"{% if current_sort == 'best-selling' %} selected{% endif %}>Best selling</option>
            <option value="title-ascending"{% if current_sort == 'title-ascending' %} selected{% endif %}>Alphabetically, A–Z</option>
            <option value="title-descending"{% if current_sort == 'title-descending' %} selected{% endif %}>Alphabetically, Z–A</option>
            <option value="price-ascending"{% if current_sort == 'price-ascending' %} selected{% endif %}>Price, low to high</option>
            <option value="price-descending"{% if current_sort == 'price-descending' %} selected{% endif %}>Price, high to low</option>
            <option value="created-ascending"{% if current_sort == 'created-ascending' %} selected{% endif %}>Date, old to new</option>
            <option value="created-descending"{% if current_sort == 'created-descending' %} selected{% endif %}>Date, new to old</option>
          </select>
        </label>
      </div>

      <p class="hygen-products__count" data-hygen-product-count>
        <span data-hygen-product-count-value>{{ collection.products_count }}</span>
        {% if collection.products_count == 1 %}product{% else %}products{% endif %}
      </p>
    </div>

    <div
      class="hygen-products__drawer"
      id="hygen-products-filter-drawer"
      data-hygen-filter-drawer
    >
      <button
        type="button"
        class="hygen-products__drawer-backdrop"
        data-hygen-filter-close
        aria-label="Close filters"
      ></button>
      <div class="hygen-products__drawer-panel" role="dialog" aria-modal="true" aria-label="Filter products">
        <div class="hygen-products__drawer-header">
          <p class="hygen-products__drawer-title">Filter</p>
          <button type="button" class="hygen-products__drawer-close" data-hygen-filter-close aria-label="Close filters">
            ×
          </button>
        </div>
        <nav class="hygen-products__drawer-nav" aria-label="Product categories" data-hygen-product-filters>
          <button type="button" class="hygen-products__drawer-option is-active" data-filter="all">Shop All</button>
          <button type="button" class="hygen-products__drawer-option" data-filter="culatta">Culatta</button>
          <button type="button" class="hygen-products__drawer-option" data-filter="belts">Belts</button>
          <button type="button" class="hygen-products__drawer-option" data-filter="wallets">Wallets</button>
          <button type="button" class="hygen-products__drawer-option" data-filter="bags">Bags</button>
          <button type="button" class="hygen-products__drawer-option" data-filter="available">Available</button>
        </nav>
      </div>
    </div>

    {% paginate collection.products by 48 %}
      <ul class="hygen-collection__grid hygen-products__grid" data-hygen-product-grid>
        {% if collection.products_count > 0 %}
          {% for product in collection.products %}
            {%- liquid
              assign categories = ''
              assign type_lower = product.type | downcase
              assign title_lower = product.title | downcase
              assign tags_lower = product.tags | join: ' ' | downcase

              if title_lower contains 'culatta' or type_lower contains 'culatta' or tags_lower contains 'culatta'
                assign categories = categories | append: ' culatta'
              endif
              for collection_ref in product.collections
                if collection_ref.handle == 'culatta' or collection_ref.handle == 'bags' or collection_ref.handle == 'belts' or collection_ref.handle == 'wallets'
                  assign categories = categories | append: ' ' | append: collection_ref.handle
                endif
              endfor
              if type_lower contains 'belt' or title_lower contains 'belt' or tags_lower contains 'belts'
                assign categories = categories | append: ' belts'
              endif
              if type_lower contains 'wallet' or title_lower contains 'wallet' or title_lower contains 'cardholder' or title_lower contains 'bifold' or tags_lower contains 'wallets'
                assign categories = categories | append: ' wallets'
              endif
              if type_lower contains 'bag' or type_lower contains 'tote' or type_lower contains 'satchel' or title_lower contains 'bag' or title_lower contains 'tote' or title_lower contains 'satchel' or tags_lower contains 'bags'
                assign categories = categories | append: ' bags'
              endif
              if product.available
                assign categories = categories | append: ' available'
              endif
            -%}
            <li
              class="hygen-collection__item hygen-products__item"
              data-categories="{{ categories | strip }}"
            >
              <a class="hygen-collection__link" href="{{ product.url }}" data-hygen-product-card-link>
                <div class="hygen-collection__media">
                  {% if product.featured_media %}
                    {% assign card_alt = product.featured_media.alt | default: product.title %}
                    {{
                      product.featured_media
                      | image_url: width: 2000
                      | image_tag:
                        loading: 'lazy',
                        class: 'hygen-collection__img',
                        widths: '400,600,800,1200,1600,2000',
                        sizes: '(min-width: 1320px) 18vw, (min-width: 1100px) 28vw, (min-width: 600px) 40vw, 45vw',
                        alt: card_alt
                    }}
                  {% endif %}
                  {% unless product.available %}
                    <span class="hygen-collection__badge">Sold out</span>
                  {% endunless %}
                </div>
                <p class="hygen-collection__name">{{ product.title }}</p>
              </a>
              {% render 'hygen-product-card-swatches', product: product %}
              <a class="hygen-collection__link hygen-collection__link--meta" href="{{ product.url }}">
                <div class="hygen-products__meta">
                  <p class="hygen-collection__price">
                    {% if product.available %}
                      <span data-hygen-price="{{ product.price }}">{{ product.price | money }}</span>
                    {% else %}
                      <span class="hygen-collection__soldout">Sold out</span>
                    {% endif %}
                  </p>
                  <p class="hygen-products__status{% unless product.available %} is-low{% endunless %}">
                    {% if product.available %}
                      Available
                    {% else %}
                      Out of Stock
                    {% endif %}
                  </p>
                </div>
              </a>
            </li>
          {% endfor %}
        {% else %}
          {% render 'hygen-cdn-grid', preset: 'latest' %}
        {% endif %}
      </ul>

      {% if paginate.pages > 1 %}
        <nav class="hygen-products__pagination" aria-label="Pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}">Previous</a>
          {% endif %}
          <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}">Next</a>
          {% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('.hygen-products');
    if (!root) return;

    var nav = root.querySelector('[data-hygen-product-filters]');
    var grid = root.querySelector('[data-hygen-product-grid]');
    var drawer = root.querySelector('[data-hygen-filter-drawer]');
    var toggle = root.querySelector('[data-hygen-filter-toggle]');
    var icon = root.querySelector('[data-hygen-filter-icon]');
    var countValue = root.querySelector('[data-hygen-product-count-value]');
    var countLabel = root.querySelector('[data-hygen-product-count]');
    var sortSelect = root.querySelector('[data-hygen-sort-select]');
    var collectionUrl = {{ collection.url | json }};

    function updateCount() {
      if (!grid || !countValue || !countLabel) return;
      var visible = 0;
      grid.querySelectorAll('.hygen-products__item').forEach(function (item) {
        if (!item.hidden) visible += 1;
      });
      countValue.textContent = String(visible);
      var suffix = countLabel.childNodes[countLabel.childNodes.length - 1];
      if (suffix && suffix.nodeType === 3) {
        suffix.textContent = visible === 1 ? ' product' : ' products';
      }
    }

    function setDrawerOpen(open) {
      if (!drawer || !toggle) return;
      drawer.classList.toggle('is-open', open);
      toggle.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (icon) icon.textContent = open ? '−' : '+';
      document.documentElement.classList.toggle('hygen-filter-drawer-open', open);
    }

    function closeDrawer() {
      setDrawerOpen(false);
    }

    function applyFilter(filter) {
      if (!nav || !grid) return;

      var activeButton = nav.querySelector('[data-filter="' + filter + '"]');
      if (!activeButton) {
        filter = 'all';
        activeButton = nav.querySelector('[data-filter="all"]');
      }

      nav.querySelectorAll('[data-filter]').forEach(function (item) {
        item.classList.toggle('is-active', item === activeButton);
      });

      grid.querySelectorAll('.hygen-products__item').forEach(function (item) {
        var categories = ' ' + (item.getAttribute('data-categories') || '') + ' ';
        var show = filter === 'all' || categories.indexOf(' ' + filter + ' ') !== -1;
        item.hidden = !show;
        item.classList.toggle('is-filter-hidden', !show);
      });

      updateCount();
    }

    if (toggle && drawer) {
      toggle.addEventListener('click', function () {
        setDrawerOpen(!drawer.classList.contains('is-open'));
      });

      drawer.querySelectorAll('[data-hygen-filter-close]').forEach(function (el) {
        el.addEventListener('click', closeDrawer);
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && drawer.classList.contains('is-open')) {
          closeDrawer();
        }
      });
    }

    if (nav && grid) {
      nav.addEventListener('click', function (event) {
        var button = event.target.closest('[data-filter]');
        if (!button) return;

        applyFilter(button.getAttribute('data-filter'));
        closeDrawer();
      });

      var initialFilter = new URLSearchParams(window.location.search).get('filter');
      if (!initialFilter && window.location.hash.indexOf('filter=') === 1) {
        initialFilter = window.location.hash.slice(8);
      }
      if (!initialFilter && {{ collection.handle | json }} !== 'all') {
        initialFilter = {{ collection.handle | json }};
      }
      if (initialFilter) {
        applyFilter(initialFilter);
      }
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', function () {
        var sortBy = sortSelect.value;
        var url = collectionUrl || window.location.pathname;
        var next = new URL(url, window.location.origin);
        next.searchParams.set('sort_by', sortBy);
        var activeFilter = new URLSearchParams(window.location.search).get('filter');
        if (activeFilter) {
          next.searchParams.set('filter', activeFilter);
        }
        window.location.assign(next.pathname + next.search);
      });
    }

    updateCount();
  })();
</script>

{% schema %}
{
  "name": "Hygen products",
  "tag": "section",
  "class": "hygen-section-products",
  "settings": [],
  "presets": [{ "name": "Hygen products" }]
}
{% endschema %}
