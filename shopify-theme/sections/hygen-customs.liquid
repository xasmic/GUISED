<section class="hygen-customs">
  <a href="{{ routes.root_url }}" class="hygen-customs__brand" aria-label="{{ shop.name | upcase | default: 'GUISED' }} home">
    {{ shop.name | upcase | default: 'GUISED' }}
  </a>

  <div class="hygen-customs__grid">
    <div class="hygen-customs__panel hygen-customs__panel--media">
      <img
        class="hygen-customs__bg"
        src="{{ 'customs-panel.jpg' | asset_url }}"
        alt=""
        width="819"
        height="1024"
        loading="eager"
      >
      <div class="hygen-customs__overlay" aria-hidden="true"></div>
      <div class="hygen-customs__ring" aria-hidden="true"></div>

      <h1 class="hygen-customs__label">{{ section.settings.title | default: 'Customs' }}</h1>

      <div class="hygen-customs__copy">
        <p class="hygen-customs__kicker">{{ section.settings.headline | default: 'MADE FOR YOU' }}</p>
        {% if section.settings.lede != blank %}
          {{ section.settings.lede | newline_to_br }}
        {% else %}
          <p>Every custom piece begins with an idea.</p>
          <p>
            Whether you have a clear vision or just a feeling you want to explore, we work closely with you to turn it into something tangible. Materials, colours, form, and details are all considered with intention, resulting in a piece that is uniquely yours.
          </p>
          <p>
            Share your idea through the form below. Let&rsquo;s make something that could only belong to you.
          </p>
        {% endif %}
      </div>
    </div>

    <div class="hygen-customs__panel hygen-customs__panel--form">
      {% form 'contact', id: 'hygen-customs-form', class: 'hygen-contact__form hygen-customs__form' %}
        <p class="hygen-customs__eyebrow">Enquiry</p>
        <h2 class="hygen-customs__form-title">{{ section.settings.cta_heading | default: 'Start a custom order' }}</h2>
        <p class="hygen-contact__required">* Required fields</p>

        <input type="hidden" name="contact[subject]" value="Custom order enquiry">

        {% if form.posted_successfully? %}
          <p class="hygen-contact__success" role="status">
            Thank you — your custom order enquiry has been sent.
          </p>
        {% endif %}

        {% if form.errors %}
          <p class="hygen-contact__error" role="alert">
            Please check the highlighted fields and try again.
          </p>
        {% endif %}

        <div class="hygen-contact__fields">
          <div class="hygen-contact__field">
            <label class="hygen-sr-only" for="hygen-customs-name">Name</label>
            <input
              id="hygen-customs-name"
              type="text"
              name="contact[name]"
              value="{{ form.name }}"
              placeholder="Name *"
              autocomplete="name"
              required
              {% if form.errors contains 'name' %}aria-invalid="true"{% endif %}
            >
          </div>

          <div class="hygen-contact__field">
            <label class="hygen-sr-only" for="hygen-customs-email">Email</label>
            <input
              id="hygen-customs-email"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="Email *"
              autocomplete="email"
              required
              {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
            >
          </div>

          <div class="hygen-contact__field">
            <label class="hygen-sr-only" for="hygen-customs-phone">Phone</label>
            <input
              id="hygen-customs-phone"
              type="tel"
              name="contact[phone]"
              value="{{ form.phone }}"
              placeholder="Phone"
              autocomplete="tel"
              {% if form.errors contains 'phone' %}aria-invalid="true"{% endif %}
            >
          </div>

          <div class="hygen-contact__field">
            <label class="hygen-sr-only" for="hygen-customs-comment">Comment</label>
            <textarea
              id="hygen-customs-comment"
              name="contact[body]"
              rows="6"
              placeholder="Comment *"
              required
              {% if form.errors contains 'body' %}aria-invalid="true"{% endif %}
            >{{ form.body }}</textarea>
          </div>
        </div>

        <div class="hygen-contact__actions">
          <button type="submit" class="hygen-contact__submit">
            Confirm
            <span aria-hidden="true"></span>
          </button>
        </div>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hygen customs",
  "tag": "section",
  "class": "hygen-section-customs",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page label",
      "default": "Customs"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Intro headline",
      "default": "MADE FOR YOU"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Intro copy (optional override)"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "Form heading",
      "default": "Start a custom order"
    }
  ],
  "presets": [{ "name": "Hygen customs" }]
}
{% endschema %}
