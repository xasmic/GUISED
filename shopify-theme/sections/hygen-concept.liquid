{%- comment -%} Featured product row (replaces manifesto copy) {%- endcomment -%}
<section class="hygen-concept hygen-shop" id="concept">
  {% render 'hygen-nav', active: 'concept' %}

  <div class="hygen-shop__inner">
    <ul class="hygen-shop__grid">
      {% for block in section.blocks %}
        <li class="hygen-shop__item" {{ block.shopify_attributes }}>
          <a
            class="hygen-shop__link"
            href="{{ block.settings.href | default: routes.root_url }}"
            {% if block.settings.href contains 'http' %}target="_blank" rel="noreferrer"{% endif %}
          >
            <div class="hygen-shop__media">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'hygen-shop__img',
                    loading: 'lazy',
                    widths: '400,600,900,1200',
                    sizes: '(min-width: 1100px) 22vw, (min-width: 600px) 40vw, 85vw',
                    alt: block.settings.title
                }}
              {% elsif block.settings.image_url != blank %}
                <img
                  class="hygen-shop__img"
                  src="{{ block.settings.image_url }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% endif %}
            </div>
            {% if block.settings.title != blank %}
              <p class="hygen-shop__title">{{ block.settings.title }}</p>
            {% endif %}
            {% if block.settings.price != blank %}
              <p class="hygen-shop__price" data-hygen-price data-hygen-price-base="{{ block.settings.price | escape }}">
                {%- assign price_parts = block.settings.price | remove: '$' | split: '.' -%}
                <span class="hygen-shop__dollars" data-hygen-price-whole>${{ price_parts[0] }}</span>
                {%- if price_parts.size > 1 -%}
                  <span class="hygen-shop__cents" data-hygen-price-cents>.{{ price_parts[1] }}</span>
                {%- endif -%}
              </p>
            {% endif %}
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Hygen shop row",
  "tag": "section",
  "class": "hygen-section-concept",
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL (fallback)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$0.00"
        },
        {
          "type": "text",
          "id": "href",
