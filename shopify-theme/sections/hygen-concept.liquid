{%- comment -%} Featured product row — prefers Shopify product objects when set {%- endcomment -%}
<section class="hygen-concept hygen-shop" id="concept">
  <div class="hygen-shop__inner">
    <ul class="hygen-shop__grid">
      {% for block in section.blocks %}
        {%- liquid
          assign product = block.settings.product
          assign title = block.settings.title
          assign href = block.settings.href
          assign price_label = block.settings.price
          assign image_url = block.settings.image_url

          if product == blank and href contains '/products/'
            assign product_handle = href | split: '/products/' | last | split: '?' | first
            assign product = all_products[product_handle]
          endif

          if product != blank
            assign title = product.title
            assign href = product.url
            assign price_label = product.price | money
          endif
        -%}
        <li class="hygen-shop__item" {{ block.shopify_attributes }}>
          <a
            class="hygen-shop__link"
            href="{{ href | default: routes.all_products_collection_url }}"
            {% if href contains 'http' %}target="_blank" rel="noreferrer"{% endif %}
          >
            <div class="hygen-shop__media">
              {% if product != blank and product.featured_media %}
                {{
                  product.featured_media
                  | image_url: width: 1200
                  | image_tag:
                    class: 'hygen-shop__img',
                    loading: 'lazy',
                    widths: '400,600,900,1200',
                    sizes: '(min-width: 1100px) 22vw, (min-width: 600px) 40vw, 85vw',
                    alt: product.featured_media.alt | default: product.title
                }}
              {% elsif block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'hygen-shop__img',
                    loading: 'lazy',
                    widths: '400,600,900,1200',
                    sizes: '(min-width: 1100px) 22vw, (min-width: 600px) 40vw, 85vw',
                    alt: title
                }}
              {% elsif image_url != blank %}
                <img
                  class="hygen-shop__img"
                  src="{{ image_url }}"
                  alt="{{ title | escape }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% endif %}
              {% if product != blank and product.available == false %}
                <span class="hygen-shop__badge">Sold out</span>
              {% endif %}
            </div>
            {% if title != blank %}
              <p class="hygen-shop__title">{{ title }}</p>
            {% endif %}
            {% if price_label != blank %}
              <p class="hygen-shop__price">{{ price_label }}</p>
            {% endif %}
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Hygen shop row",
  "tag": "section",
  "class": "hygen-section-concept",
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Shopify product (preferred)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL fallback"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title fallback",
          "default": "Product"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price fallback",
          "default": "$0.00"
        },
        {
          "type": "url",
          "id": "href",
          "label": "Link fallback"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hygen shop row",
      "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }, { "type": "product" }]
    }
  ]
}
{% endschema %}
