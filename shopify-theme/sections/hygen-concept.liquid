<section class="hygen-concept" id="concept">
  {% render 'hygen-nav', active: 'concept' %}

  <div class="hygen-concept__inner">
    <h1 class="hygen-concept__title">
      {{ section.settings.title | default: shop.name | upcase }}
    </h1>
    {% if section.settings.body != blank %}
      <div class="hygen-concept__body">{{ section.settings.body }}</div>
    {% endif %}
    {% if section.settings.body_secondary != blank %}
      <div class="hygen-concept__secondary">{{ section.settings.body_secondary }}</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hygen concept",
  "tag": "section",
  "class": "hygen-section-concept",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "GUISED"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "A product has a concept that gives you a feeling of tension — reconsidered from the basic style. Leather goods that wear your story. Slowly and obsessively crafted, evolving through imperfections."
    },
    {
      "type": "textarea",
      "id": "body_secondary",
      "label": "Secondary body",
      "default": "Handcrafted in Singapore. Culatta, belts, wallets, bags — arranged as an archive."
    }
  ],
  "presets": [{ "name": "Hygen concept" }]
}
{% endschema %}
