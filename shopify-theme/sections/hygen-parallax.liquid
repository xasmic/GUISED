{%- liquid
  assign fallback = section.settings.image_url
  if fallback == blank
    if section.settings.heading == 'Collaboration'
      assign fallback = 'hygen-parallax-lower.png' | asset_url
    else
      assign fallback = 'hygen-parallax-mid.png' | asset_url
    endif
  endif
-%}

<section class="hygen-parallax" aria-label="{{ section.settings.heading | escape }}">
  {% if section.settings.image != blank %}
    <div
      class="hygen-parallax__bg"
      style="background-image: url({{ section.settings.image | image_url: width: 2400 }});"
      role="img"
      aria-label="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
    ></div>
  {% else %}
    <div
      class="hygen-parallax__bg"
      style="background-image: url({{ fallback }});"
      role="img"
      aria-label="{{ section.settings.heading | escape }}"
    ></div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hygen parallax",
  "tag": "section",
  "class": "hygen-section-parallax",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Accessibility label",
      "default": "Look"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Full-bleed image (optional override)"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL (blank = theme asset)",
      "default": ""
    }
  ],
  "presets": [{ "name": "Hygen parallax" }]
}
{% endschema %}
