{%- liquid
  assign use_video = false
  if section.settings.video_url != blank
    assign use_video = true
    assign video_src = section.settings.video_url
  elsif section.settings.use_theme_video
    assign use_video = true
    assign video_src = 'GuisedVideo.mp4' | asset_url
  endif

  assign fallback = section.settings.image_url
  if fallback == blank
    if section.settings.heading == 'Collaboration'
      assign fallback = 'hygen-parallax-lower.png' | asset_url
    else
      assign fallback = 'hygen-parallax-mid.png' | asset_url
    endif
  endif
-%}

<section class="hygen-parallax" aria-label="{{ section.settings.heading | escape }}">
  {% if use_video %}
    <video
      class="hygen-parallax__video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-label="{{ section.settings.heading | escape }}"
    >
      <source src="{{ video_src }}" type="video/mp4">
    </video>
  {% elsif section.settings.image != blank %}
    <div
      class="hygen-parallax__bg"
      style="background-image: url({{ section.settings.image | image_url: width: 2400 }});"
      role="img"
      aria-label="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
    ></div>
  {% else %}
    <div
      class="hygen-parallax__bg"
      style="background-image: url({{ fallback }});"
      role="img"
      aria-label="{{ section.settings.heading | escape }}"
    ></div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hygen parallax",
  "tag": "section",
  "class": "hygen-section-parallax",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Accessibility label",
      "default": "Look"
    },
    {
      "type": "checkbox",
      "id": "use_theme_video",
      "label": "Use GuisedVideo.mp4 from theme assets",
      "default": false
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (optional override)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Full-bleed image (optional override)"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL (blank = theme asset)"
    }
  ],
  "presets": [{ "name": "Hygen parallax" }]
}
{% endschema %}
