{%- liquid
  assign fallback = section.settings.image_url
  if fallback == blank
    if section.settings.heading == 'Collaboration'
      assign fallback = 'https://atelierguised.com/cdn/shop/collections/C3D43191-4BEE-44D3-8E07-B58AE4E95CD9.jpg?v=1765362909&width=2000'
    else
      assign fallback = 'https://atelierguised.com/cdn/shop/files/Guised-02087_SHOPIFY_CROP.jpg?v=1761817097&width=2000'
    endif
  endif
-%}

<section class="hygen-parallax" aria-label="{{ section.settings.heading | escape }}">
  {% if section.settings.image != blank %}
    <div
      class="hygen-parallax__bg"
      style="background-image: url({{ section.settings.image | image_url: width: 2400 }});"
      role="img"
      aria-label="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
    ></div>
  {% else %}
    <div
      class="hygen-parallax__bg"
      style="background-image: url({{ fallback }});"
      role="img"
      aria-label="{{ section.settings.heading | escape }}"
    ></div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hygen parallax",
  "tag": "section",
  "class": "hygen-section-parallax",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Accessibility label",
      "default": "Look"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Full-bleed image (optional override)"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL (uses site CDN by default)",
      "default": "https://atelierguised.com/cdn/shop/files/Guised-02087_SHOPIFY_CROP.jpg?v=1761817097&width=2000"
    }
  ],
  "presets": [{ "name": "Hygen parallax" }]
}
{% endschema %}
