<section class="hygen-collection" id="collection" data-hygen-collection>
  {% render 'hygen-nav', active: 'collection' %}

  <div class="hygen-collection__index">
    <p class="hygen-collection__heading">{{ section.settings.heading }}</p>
    <ul>
      {% for block in section.blocks %}
        {% if block.type == 'season' %}
          <li {{ block.shopify_attributes }}>
            <button
              type="button"
              data-hygen-season
              {% if forloop.first %}class="is-active"{% endif %}
            >
              {{ block.settings.label }}
            </button>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>

  <div class="hygen-collection__stage">
    {% assign season_index = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'season' %}
        {% assign season_collection = block.settings.collection %}
        <div
          class="hygen-season{% if season_index == 0 %} is-active{% endif %}"
          data-slide-index="0"
          data-season-index="{{ season_index }}"
        >
          <div class="hygen-collection__media">
            {% if season_collection != blank and season_collection.products_count > 0 %}
              {% for product in season_collection.products limit: block.settings.limit %}
                <div class="hygen-slide{% if forloop.first %} is-active{% endif %}">
                  <a href="{{ product.url }}">
                    {% if product.featured_media %}
                      {{
                        product.featured_media
                        | image_url: width: 1200
                        | image_tag:
                          loading: 'lazy',
                          widths: '400,600,800,1200',
                          sizes: '(min-width: 1500px) 600px, 467px',
                          alt: product.featured_media.alt | default: product.title
                      }}
                    {% endif %}
                  </a>
                </div>
              {% endfor %}
            {% else %}
              {% render 'hygen-cdn-slides', preset: block.settings.preset, mode: 'slides' %}
            {% endif %}

            <button type="button" class="hygen-collection__arrow hygen-collection__arrow--prev" data-hygen-prev aria-label="Previous">‹</button>
            <button type="button" class="hygen-collection__arrow hygen-collection__arrow--next" data-hygen-next aria-label="Next">›</button>
          </div>
        </div>
        {% assign season_index = season_index | plus: 1 %}
      {% endif %}
    {% endfor %}

    <button type="button" class="hygen-collection__index-btn" data-hygen-open-index>
      Index
    </button>
  </div>

  <div class="hygen-modal" data-hygen-modal role="dialog" aria-modal="true" aria-label="Lookbook index">
    <button type="button" class="hygen-modal__close" data-hygen-close-index>Close</button>
    <div class="hygen-modal__panel">
      {% assign season_index = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'season' %}
          {% assign season_collection = block.settings.collection %}
          <div class="hygen-modal-season{% if season_index == 0 %} is-active{% endif %} hygen-modal__grid">
            {% if season_collection != blank and season_collection.products_count > 0 %}
              {% for product in season_collection.products limit: block.settings.limit %}
                <button
                  type="button"
                  class="hygen-modal__thumb"
                  data-hygen-thumb
                  data-season="{{ season_index }}"
                  data-slide="{{ forloop.index0 }}"
                >
                  {% if product.featured_media %}
                    {{
                      product.featured_media
                      | image_url: width: 240
                      | image_tag: loading: 'lazy', alt: product.title
                    }}
                  {% endif %}
                </button>
              {% endfor %}
            {% else %}
              {% render 'hygen-cdn-slides', preset: block.settings.preset, mode: 'thumbs', season_index: season_index %}
            {% endif %}
          </div>
          {% assign season_index = season_index | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hygen collection",
  "tag": "section",
  "class": "hygen-section-collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collection"
    },
    {
      "type": "paragraph",
      "content": "If no collection is linked, seasons use the same Atelier Guised CDN images as the website. Linking a collection switches to live product photos."
    }
  ],
  "blocks": [
    {
      "type": "season",
      "name": "Season / lookbook",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "List label",
          "default": "GUISED  Latest Releases"
        },
        {
          "type": "select",
          "id": "preset",
          "label": "CDN image set (when no collection)",
          "options": [
            { "value": "latest", "label": "Latest Releases" },
            { "value": "culatta", "label": "Culatta" },
            { "value": "belts", "label": "Belts" },
            { "value": "wallets", "label": "Wallets" },
            { "value": "campaign", "label": "Campaign" },
            { "value": "collab", "label": "Collab" }
          ],
          "default": "latest"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection (optional override)"
        },
        {
          "type": "range",
          "id": "limit",
          "label": "Product limit",
          "min": 1,
          "max": 24,
          "step": 1,
          "default": 12
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hygen collection",
      "blocks": [
        { "type": "season", "settings": { "label": "GUISED  Latest Releases", "preset": "latest" } },
        { "type": "season", "settings": { "label": "GUISED  Culatta", "preset": "culatta" } },
        { "type": "season", "settings": { "label": "GUISED  Belts", "preset": "belts" } },
        { "type": "season", "settings": { "label": "GUISED  Wallets", "preset": "wallets" } },
        { "type": "season", "settings": { "label": "GUISED  Campaign", "preset": "campaign" } },
        { "type": "season", "settings": { "label": "Guised × Rei.Gloom", "preset": "collab" } }
      ]
    }
  ]
}
{% endschema %}
