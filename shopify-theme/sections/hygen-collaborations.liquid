{%- comment -%}
  Collaborations page — Hygen archive layout with product detail for featured drops.

  HOW TO ADD A NEW COLLABORATION (Theme Editor):
  1. Online Store → Pages → Collaborations → Customize
  2. Open the "Hygen collaborations" section
  3. Add block:
     - "Featured collaboration" → live drop (image, copy, detail, Shop CTA)
     - "Coming soon teaser" → future drop hint (blurred image, no CTA)
  4. Reorder blocks; featured blocks render first, then teasers.

  Or edit this section’s blocks in templates/page.collaborations.json.
{%- endcomment -%}

<section class="hygen-collabs">
  <div class="hygen-collabs__intro">
    <p class="hygen-collabs__eyebrow">{{ section.settings.eyebrow | default: 'Archive' }}</p>
    <h1 class="hygen-collabs__title">{{ section.settings.title | default: 'Collaborations' }}</h1>
    {% if section.settings.lede != blank %}
      <p class="hygen-collabs__lede">{{ section.settings.lede }}</p>
    {% endif %}
  </div>

  {% for block in section.blocks %}
    {% if block.type == 'featured' %}
      <article class="hygen-collabs__feature" {{ block.shopify_attributes }}>
        <div class="hygen-collabs__feature-inner">
          <div class="hygen-collabs__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'eager',
                  widths: '600,900,1200,1600',
                  sizes: '(min-width: 900px) 46vw, 92vw',
                  alt: block.settings.image.alt | default: block.settings.partners
              }}
            {% else %}
              <img
                src="{{ 'hygen-campaign-2.png' | asset_url }}"
                alt="{{ block.settings.partners | escape }}"
                width="1200"
                height="1500"
                loading="eager"
              >
            {% endif %}
          </div>

          <div class="hygen-collabs__copy">
            {% if block.settings.season != blank %}
              <p class="hygen-collabs__season">{{ block.settings.season }}</p>
            {% endif %}
            <h2 class="hygen-collabs__partners">{{ block.settings.partners }}</h2>
            {% if block.settings.subtitle != blank %}
              <p class="hygen-collabs__subtitle">{{ block.settings.subtitle }}</p>
            {% endif %}
            {% if block.settings.summary != blank %}
              <p class="hygen-collabs__summary">{{ block.settings.summary }}</p>
            {% endif %}
            {% if block.settings.warranty != blank %}
              <p class="hygen-collabs__warranty">
                <span>Warranty</span>
                {{ block.settings.warranty }}
              </p>
            {% endif %}

            {%- liquid
              assign cta_label = block.settings.cta_label | default: 'Shop the collection'
              assign cta_url = block.settings.cta_link
              if cta_url == blank and block.settings.collection != blank
                assign cta_url = block.settings.collection.url
              endif
              if cta_url == blank
                assign cta_url = collections['guised-x-rei-gloom'].url | default: routes.all_products_collection_url
              endif
            -%}
            {% if cta_label != blank and cta_url != blank %}
              <a class="hygen-collabs__cta" href="{{ cta_url }}">
                {{ cta_label }}
                <span aria-hidden="true"></span>
              </a>
            {% endif %}
          </div>
        </div>

        {%- liquid
          assign has_detail = false
          if block.settings.about != blank or block.settings.production != blank or block.settings.specifications != blank or block.settings.features != blank or block.settings.material_notes != blank or block.settings.care != blank
            assign has_detail = true
          endif
        -%}

        {% if has_detail %}
          <div class="hygen-collabs__detail">
            {% if block.settings.about != blank %}
              <section class="hygen-collabs__block">
                <h3 class="hygen-collabs__block-title">About</h3>
                <div class="hygen-collabs__prose">{{ block.settings.about | escape }}</div>
              </section>
            {% endif %}

            {% if block.settings.production != blank %}
              <section class="hygen-collabs__block">
                <h3 class="hygen-collabs__block-title">Production</h3>
                <div class="hygen-collabs__prose">{{ block.settings.production | escape }}</div>
              </section>
            {% endif %}

            {% if block.settings.specifications != blank %}
              <section class="hygen-collabs__block">
                <h3 class="hygen-collabs__block-title">Specifications</h3>
                <dl class="hygen-collabs__specs">
                  {%- assign spec_lines = block.settings.specifications | newline_to_br | split: '<br />' -%}
                  {% for line in spec_lines %}
                    {%- assign trimmed = line | strip -%}
                    {% if trimmed != blank %}
                      {%- assign parts = trimmed | split: ': ' -%}
                      {%- if parts.size > 1 -%}
                        <div class="hygen-collabs__spec">
                          <dt>{{ parts.first | strip }}</dt>
                          <dd>{{ parts | slice: 1, 20 | join: ': ' | strip }}</dd>
                        </div>
                      {%- endif -%}
                    {% endif %}
                  {% endfor %}
                </dl>
              </section>
            {% endif %}

            {% if block.settings.features != blank %}
              <section class="hygen-collabs__block">
                <h3 class="hygen-collabs__block-title">Features</h3>
                <ul class="hygen-collabs__list">
                  {%- assign feature_lines = block.settings.features | newline_to_br | split: '<br />' -%}
                  {% for line in feature_lines %}
                    {%- assign trimmed = line | strip -%}
                    {% if trimmed != blank %}
                      <li>{{ trimmed }}</li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </section>
            {% endif %}

            {% if block.settings.material_notes != blank %}
              <section class="hygen-collabs__block">
                <h3 class="hygen-collabs__block-title">Material notes</h3>
                <div class="hygen-collabs__prose">{{ block.settings.material_notes | escape }}</div>
              </section>
            {% endif %}

            {% if block.settings.care != blank %}
              <section class="hygen-collabs__block">
                <h3 class="hygen-collabs__block-title">Care &amp; maintenance</h3>
                <ul class="hygen-collabs__list">
                  {%- assign care_lines = block.settings.care | newline_to_br | split: '<br />' -%}
                  {% for line in care_lines %}
                    {%- assign trimmed = line | strip -%}
                    {% if trimmed != blank %}
                      <li>{{ trimmed }}</li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </section>
            {% endif %}
          </div>
        {% endif %}
      </article>
    {% endif %}
  {% endfor %}

  {%- assign coming_count = 0 -%}
  {% for block in section.blocks %}
    {% if block.type == 'coming' %}
      {%- assign coming_count = coming_count | plus: 1 -%}
    {% endif %}
  {% endfor %}

  {% if coming_count > 0 or section.settings.forthcoming_title != blank %}
    <section class="hygen-collabs__forthcoming">
      <div class="hygen-collabs__forthcoming-inner">
        {% if section.settings.forthcoming_eyebrow != blank %}
          <p class="hygen-collabs__eyebrow">{{ section.settings.forthcoming_eyebrow }}</p>
        {% endif %}
        <h2 class="hygen-collabs__forthcoming-title">
          {{ section.settings.forthcoming_title | default: 'Coming soon' }}
        </h2>
        {% if section.settings.forthcoming_lede != blank %}
          <p class="hygen-collabs__forthcoming-lede">{{ section.settings.forthcoming_lede }}</p>
        {% endif %}

        {% if coming_count > 0 %}
          <ul class="hygen-collabs__coming-list">
            {% for block in section.blocks %}
              {% if block.type == 'coming' %}
                <li {{ block.shopify_attributes }}>
                  <div class="hygen-collabs__coming-media">
                    {% if block.settings.image != blank %}
                      {{
                        block.settings.image
                        | image_url: width: 1200
                        | image_tag:
                          loading: 'lazy',
                          widths: '400,700,1000,1200',
                          sizes: '(min-width: 700px) 45vw, 92vw',
                          alt: ''
                      }}
                    {% else %}
                      <img
                        src="{{ 'hygen-campaign-3.png' | asset_url }}"
                        alt=""
                        width="1200"
                        height="750"
                        loading="lazy"
                      >
                    {% endif %}
                    <span class="hygen-collabs__coming-season">
                      {{ block.settings.label | default: 'Coming soon' }}
                    </span>
                  </div>
                  {% if block.settings.partners != blank %}
                    <p class="hygen-collabs__coming-partners">{{ block.settings.partners }}</p>
                  {% endif %}
                  {% if block.settings.summary != blank %}
                    <p class="hygen-collabs__coming-summary">{{ block.settings.summary }}</p>
                  {% endif %}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        {% if section.settings.note != blank %}
          <div class="hygen-collabs__note">
            {{ section.settings.note }}
          </div>
        {% endif %}
      </div>
    </section>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hygen collaborations",
  "tag": "section",
  "class": "hygen-section-collabs",
  "settings": [
    {
      "type": "header",
      "content": "Page hero"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Archive"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Collaborations"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Intro",
      "default": "Occasional pairings between Guised and artists who share a language of material, shadow, and wear. Each chapter is finite — made slowly, released once."
    },
    {
      "type": "header",
      "content": "Coming soon section"
    },
    {
      "type": "text",
      "id": "forthcoming_eyebrow",
      "label": "Eyebrow",
      "default": "Forthcoming"
    },
    {
      "type": "text",
      "id": "forthcoming_title",
      "label": "Title",
      "default": "Coming soon"
    },
    {
      "type": "textarea",
      "id": "forthcoming_lede",
      "label": "Supporting text",
      "default": "Further chapters are in motion. Names stay quiet until the work can speak for itself."
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Footer note",
      "default": "<p>Future chapters will appear here as they open. For collaboration enquiries, write to <a href=\"mailto:atelierguise@gmail.com\">atelierguise@gmail.com</a>.</p>"
    },
    {
      "type": "paragraph",
      "content": "Add new drops with “Featured collaboration” blocks. Hint at future work with “Coming soon teaser” blocks."
    }
  ],
  "blocks": [
    {
      "type": "featured",
      "name": "Featured collaboration",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Cover image"
        },
        {
          "type": "text",
          "id": "season",
          "label": "Chapter / season label",
          "default": "Chapter I"
        },
        {
          "type": "text",
          "id": "partners",
          "label": "Partners",
          "default": "GUISED × REI GLOOM"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Series title",
          "default": "Belt (Abstract)"
        },
        {
          "type": "textarea",
          "id": "summary",
          "label": "Hero summary",
          "default": "A one-of-one statement piece combining handcrafted leatherwork with the expressive language of tattoo artistry."
        },
        {
          "type": "text",
          "id": "warranty",
          "label": "Warranty",
          "default": "1-year craftsmanship coverage"
        },
        {
          "type": "header",
          "content": "Detail sections"
        },
        {
          "type": "textarea",
          "id": "about",
          "label": "About (paragraphs, blank line between)"
        },
        {
          "type": "textarea",
          "id": "production",
          "label": "Production (paragraphs, blank line between)"
        },
        {
          "type": "textarea",
          "id": "specifications",
          "label": "Specifications (one Label: value per line)"
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Features (one per line)"
        },
        {
          "type": "textarea",
          "id": "material_notes",
          "label": "Material notes (paragraphs, blank line between)"
        },
        {
          "type": "textarea",
          "id": "care",
          "label": "Care & maintenance (one per line)"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Linked collection"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "CTA link (overrides collection)"
        },
        {
          "type": "text",
