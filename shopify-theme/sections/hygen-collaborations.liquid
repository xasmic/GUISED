{%- comment -%}
  Collaborations page — featured drops link to dedicated detail pages.
{%- endcomment -%}

<section class="hygen-collabs">
  <div class="hygen-collabs__intro">
    <p class="hygen-collabs__eyebrow">{{ section.settings.eyebrow | default: 'Archive' }}</p>
    <h1 class="hygen-collabs__title">{{ section.settings.title | default: 'Collaborations' }}</h1>
    {% if section.settings.lede != blank %}
      <p class="hygen-collabs__lede">{{ section.settings.lede }}</p>
    {% endif %}
  </div>

  {% for block in section.blocks %}
    {% if block.type == 'featured' %}
      <article class="hygen-collabs__feature" {{ block.shopify_attributes }}>
        <div class="hygen-collabs__feature-inner">
          <div class="hygen-collabs__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 2400
                | image_tag:
                  loading: 'eager',
                  widths: '600,900,1200,1600,2000,2400',
                  sizes: '(min-width: 900px) 46vw, 92vw',
                  alt: block.settings.image.alt | default: block.settings.partners
              }}
            {% else %}
              <img
                src="{{ 'hygen-campaign-2.png' | asset_url }}"
                alt="{{ block.settings.partners | escape }}"
                width="1200"
                height="1500"
                loading="eager"
              >
            {% endif %}
          </div>

          <div class="hygen-collabs__copy">
            {% if block.settings.season != blank %}
              <p class="hygen-collabs__season">{{ block.settings.season }}</p>
            {% endif %}
            <h2 class="hygen-collabs__partners">{{ block.settings.partners }}</h2>
            {% if block.settings.subtitle != blank %}
              <p class="hygen-collabs__subtitle">{{ block.settings.subtitle }}</p>
            {% endif %}
            {% if block.settings.summary != blank %}
              <p class="hygen-collabs__summary">{{ block.settings.summary }}</p>
            {% endif %}
            {% if block.settings.warranty != blank %}
              <p class="hygen-collabs__warranty">
                <span>Warranty</span>
                {{ block.settings.warranty }}
              </p>
            {% endif %}

        {%- liquid
          assign cta_label = block.settings.cta_label | default: 'Learn more'
          assign cta_url = block.settings.cta_link
          if cta_url == blank and block.settings.chapter_handle != blank
            assign cta_url = '/pages/' | append: block.settings.chapter_handle
          elsif cta_url == blank and block.settings.collection != blank
            assign cta_url = block.settings.collection.url
          endif
        -%}
            {% if cta_label != blank and cta_url != blank %}
              <a class="hygen-collabs__cta" href="{{ cta_url }}">
                {{ cta_label }}
                <span aria-hidden="true"></span>
              </a>
            {% endif %}
          </div>
        </div>

        {% if block.settings.show_inline_detail %}
          {% render 'hygen-collaboration-detail-content',
            about: block.settings.about,
            production: block.settings.production,
            specifications: block.settings.specifications,
            features: block.settings.features,
            material_notes: block.settings.material_notes,
            care: block.settings.care
          %}
        {% endif %}
      </article>
    {% endif %}
  {% endfor %}

  {%- assign coming_count = 0 -%}
  {% for block in section.blocks %}
    {% if block.type == 'coming' %}
      {%- assign coming_count = coming_count | plus: 1 -%}
    {% endif %}
  {% endfor %}

  {% if coming_count > 0 %}
    <section class="hygen-collabs__forthcoming">
      <div class="hygen-collabs__forthcoming-inner">
        {% if section.settings.forthcoming_eyebrow != blank %}
          <p class="hygen-collabs__eyebrow">{{ section.settings.forthcoming_eyebrow }}</p>
        {% endif %}
        <h2 class="hygen-collabs__forthcoming-title">
          {{ section.settings.forthcoming_title | default: 'Coming soon' }}
        </h2>
        {% if section.settings.forthcoming_lede != blank %}
          <p class="hygen-collabs__forthcoming-lede">{{ section.settings.forthcoming_lede }}</p>
        {% endif %}

        {% if coming_count > 0 %}
          <ul class="hygen-collabs__coming-list">
            {% for block in section.blocks %}
              {% if block.type == 'coming' %}
                <li {{ block.shopify_attributes }}>
                  <div class="hygen-collabs__coming-media">
                    {% if block.settings.image != blank %}
                      {{
                        block.settings.image
                        | image_url: width: 2000
                        | image_tag:
                          loading: 'lazy',
                          widths: '400,700,1000,1200,1600,2000',
                          sizes: '(min-width: 700px) 45vw, 92vw',
                          alt: ''
                      }}
                    {% else %}
                      <img
                        src="{{ 'hygen-campaign-3.png' | asset_url }}"
                        alt=""
                        width="1200"
                        height="750"
                        loading="lazy"
                      >
                    {% endif %}
                    <span class="hygen-collabs__coming-season">
                      {{ block.settings.label | default: 'Coming soon' }}
                    </span>
                  </div>
                  {% if block.settings.partners != blank %}
                    <p class="hygen-collabs__coming-partners">{{ block.settings.partners }}</p>
                  {% endif %}
                  {% if block.settings.summary != blank %}
                    <p class="hygen-collabs__coming-summary">{{ block.settings.summary }}</p>
                  {% endif %}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        {% if section.settings.note != blank %}
          <div class="hygen-collabs__note">
            {{ section.settings.note }}
          </div>
        {% endif %}
      </div>
    </section>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hygen collaborations",
  "tag": "section",
  "class": "hygen-section-collabs",
  "settings": [
    {
      "type": "header",
      "content": "Page hero"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Archive"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Collaborations"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Intro",
      "default": "Occasional pairings between Guised and artists who share a language of material, shadow, and wear. Each chapter is finite — made slowly, released once."
    },
    {
      "type": "header",
      "content": "Coming soon section"
    },
    {
      "type": "text",
      "id": "forthcoming_eyebrow",
      "label": "Eyebrow",
      "default": "Forthcoming"
    },
    {
      "type": "text",
      "id": "forthcoming_title",
      "label": "Title",
      "default": "Coming soon"
    },
    {
      "type": "textarea",
      "id": "forthcoming_lede",
      "label": "Supporting text",
      "default": "Further chapters are in motion. Names stay quiet until the work can speak for itself."
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Footer note",
      "default": "<p>Future chapters will appear here as they open. For collaboration enquiries, write to <a href=\"mailto:atelierguise@gmail.com\">atelierguise@gmail.com</a>.</p>"
    },
    {
      "type": "paragraph",
      "content": "Add new drops with “Featured collaboration” blocks. Hint at future work with “Coming soon teaser” blocks."
    }
  ],
  "blocks": [
    {
      "type": "featured",
      "name": "Featured collaboration",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Cover image"
        },
        {
          "type": "text",
          "id": "season",
          "label": "Chapter / season label",
          "default": "Chapter I"
        },
        {
          "type": "text",
          "id": "partners",
          "label": "Partners",
          "default": "GUISED × REI GLOOM"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Series title",
          "default": "Belt (Abstract)"
        },
        {
          "type": "textarea",
          "id": "summary",
          "label": "Hero summary",
          "default": "A one-of-one statement piece combining handcrafted leatherwork with the expressive language of tattoo artistry."
        },
        {
          "type": "text",
          "id": "warranty",
          "label": "Warranty",
          "default": "1-year craftsmanship coverage"
        },
        {
          "type": "text",
          "id": "chapter_handle",
          "label": "Chapter URL handle",
          "default": "rei-gloom-belt",
          "info": "Used for Learn more links when CTA link is empty: /pages/handle"
        },
        {
          "type": "checkbox",
          "id": "show_inline_detail",
          "label": "Show detail sections on this page",
          "default": false,
          "info": "Turn off when detail lives on a separate page linked by the CTA."
        },
        {
          "type": "header",
          "content": "Detail sections"
        },
        {
          "type": "textarea",
          "id": "about",
          "label": "About (paragraphs, blank line between)"
        },
        {
          "type": "textarea",
          "id": "production",
          "label": "Production (paragraphs, blank line between)"
        },
        {
          "type": "textarea",
          "id": "specifications",
          "label": "Specifications (one Label: value per line)"
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Features (one per line)"
        },
        {
          "type": "textarea",
          "id": "material_notes",
          "label": "Material notes (paragraphs, blank line between)"
        },
        {
          "type": "textarea",
          "id": "care",
          "label": "Care & maintenance (one per line)"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Linked collection"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "CTA link (overrides collection)"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "Learn more"
        }
      ]
    },
    {
      "type": "coming",
      "name": "Coming soon teaser",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Teaser image (shown blurred / greyed)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Overlay label",
          "default": "Coming soon"
        },
        {
          "type": "text",
          "id": "partners",
          "label": "Partners (optional hint)",
          "default": "Guised × —"
        },
        {
          "type": "textarea",
          "id": "summary",
          "label": "Short teaser copy",
          "default": "A forthcoming exchange. Details withheld until the hides are ready."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hygen collaborations",
      "blocks": [
        {
          "type": "featured",
          "settings": {
            "season": "Chapter I",
            "partners": "GUISED × REI GLOOM",
            "subtitle": "Belt (Abstract)",
            "summary": "A one-of-one statement piece combining handcrafted leatherwork with the expressive language of tattoo artistry.",
            "warranty": "1-year craftsmanship coverage",
            "cta_label": "Learn more"
          }
        },
        {
          "type": "coming",
          "settings": {
            "label": "Chapter II",
            "partners": "Guised × —",
            "summary": "A forthcoming exchange with a Singapore-based maker. Details withheld until the hides are ready."
          }
        },
        {
          "type": "coming",
          "settings": {
            "label": "Chapter III",
            "partners": "Guised × —",
            "summary": "An overseas collaboration in early conversation. Expect quieter hardware, denser leather, and a longer lead."
          }
        }
      ]
    }
  ]
}
{% endschema %}
