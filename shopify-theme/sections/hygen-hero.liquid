{%- liquid
  if section.settings.image != blank
    assign desktop_src = section.settings.image | image_url: width: 3200
  elsif section.settings.image_url != blank
    assign desktop_src = section.settings.image_url
  else
    assign desktop_src = 'hygen-hero-poster.jpg' | asset_url
  endif

  if section.settings.mobile_image != blank
    assign mobile_src = section.settings.mobile_image | image_url: width: 1600
  elsif section.settings.mobile_image_url != blank
    assign mobile_src = section.settings.mobile_image_url
  else
    assign mobile_src = 'hygen-hero-mobile.jpg' | asset_url
  endif

  if section.settings.video_url != blank
    assign video_src = section.settings.video_url
  else
    assign video_src = 'hygen-hero.mp4' | asset_url
  endif
-%}

<section class="hygen-hero" data-hygen-hero>
  {% if section.settings.use_video and section.settings.video != blank %}
    {{
      section.settings.video
      | video_tag:
        autoplay: true,
        loop: true,
        muted: true,
        controls: false,
        image_size: '3200x',
        class: 'hygen-hero__video'
    }}
  {% elsif section.settings.use_video %}
    <video
      class="hygen-hero__video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="{{ desktop_src }}"
    >
      <source src="{{ video_src }}" type="video/mp4">
    </video>
  {% endif %}

  <picture>
    <source
      media="(min-width: 1025px)"
      srcset="{{ desktop_src }}"
    >
    <img
      class="hygen-hero__image"
      src="{{ mobile_src }}"
      alt="{{ shop.name | escape }}"
      loading="eager"
      fetchpriority="high"
      width="819"
      height="1024"
    >
  </picture>

  <div class="hygen-hero__veil"></div>

  <div class="hygen-hero__copy">
    <h1 class="hygen-hero__brand">
      {{ section.settings.brand | default: shop.name | upcase }}
    </h1>
    {% if section.settings.tagline != blank %}
      <p class="hygen-hero__tagline">{{ section.settings.tagline }}</p>
    {% endif %}
    {% if section.settings.cta_label != blank %}
      <a class="hygen-hero__cta" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
        {{ section.settings.cta_label }}
      </a>
    {% endif %}
  </div>

  <a class="hygen-hero__down" href="#concept" aria-label="Scroll to featured pieces">
    <span class="hygen-hero__chevron" aria-hidden="true"></span>
  </a>
</section>

{% schema %}
{
  "name": "Hygen hero",
  "tag": "section",
  "class": "hygen-section-hero",
  "settings": [
    {
      "type": "paragraph",
      "content": "Desktop uses the landscape hero. Mobile uses the portrait hero. They are independent images."
    },
    {
      "type": "text",
      "id": "brand",
      "label": "Brand wordmark",
      "default": "GUISED"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Obsessively Crafted"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "CTA link",
      "default": "/collections/all"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop hero image (landscape)"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Desktop hero URL (blank = hygen-hero-poster.jpg)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile hero image (portrait)"
    },
    {
      "type": "text",
      "id": "mobile_image_url",
      "label": "Mobile hero URL (blank = hygen-hero-mobile.jpg)"
    },
    {
      "type": "checkbox",
      "id": "use_video",
      "label": "Play desktop hero video over landscape image",
      "default": false
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video (optional override)"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Hero MP4 URL (blank = theme asset)"
    }
  ],
  "presets": [{ "name": "Hygen hero" }]
}
{% endschema %}
