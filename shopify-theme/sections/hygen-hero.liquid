{%- liquid
  if section.settings.image_url != blank
    assign poster = section.settings.image_url
  else
    assign poster = 'hygen-hero-poster.jpg' | asset_url
  endif

  if section.settings.video_url != blank
    assign video_src = section.settings.video_url
  else
    assign video_src = 'hygen-hero.mp4' | asset_url
  endif
-%}

<section class="hygen-hero" data-hygen-hero>
  {% if section.settings.video != blank %}
    {{
      section.settings.video
      | video_tag:
        autoplay: true,
        loop: true,
        muted: true,
        controls: false,
        image_size: '1920x',
        class: 'hygen-hero__video'
    }}
  {% else %}
    <video
      class="hygen-hero__video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1920 }}{% else %}{{ poster }}{% endif %}"
    >
      <source src="{{ video_src }}" type="video/mp4">
    </video>
  {% endif %}

  {% if section.settings.image != blank %}
    {{
      section.settings.image
      | image_url: width: 2400
      | image_tag:
        class: 'hygen-hero__image',
        loading: 'eager',
        widths: '750,1100,1500,1920,2400',
        sizes: '100vw',
        alt: section.settings.image.alt | default: shop.name
    }}
  {% else %}
    <img
      class="hygen-hero__image"
      src="{{ poster }}"
      alt="{{ shop.name | escape }}"
      loading="eager"
      width="1920"
      height="1080"
    >
  {% endif %}

  <div class="hygen-hero__veil"></div>

  <div class="hygen-hero__copy">
    <h1 class="hygen-hero__brand">
      {{ section.settings.brand | default: shop.name | upcase }}
    </h1>
    {% if section.settings.tagline != blank %}
      <p class="hygen-hero__tagline">{{ section.settings.tagline }}</p>
    {% endif %}
    {% if section.settings.cta_label != blank %}
      <a class="hygen-hero__cta" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
        {{ section.settings.cta_label }}
      </a>
    {% endif %}
  </div>

  <a class="hygen-hero__down" href="#concept" aria-label="Scroll to featured pieces">
    <span class="hygen-hero__chevron" aria-hidden="true"></span>
  </a>
</section>

{% schema %}
{
  "name": "Hygen hero",
  "tag": "section",
  "class": "hygen-section-hero",
  "settings": [
    {
      "type": "paragraph",
      "content": "Defaults use theme assets (hygen-hero-poster.jpg / hygen-hero.mp4). Override with Shopify Files pickers or custom URLs."
    },
    {
      "type": "text",
      "id": "brand",
      "label": "Brand wordmark",
      "default": "GUISED"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "obsessively crafted"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "CTA link",
      "default": "/collections/all"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Poster / mobile image (optional override)"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Poster image URL (blank = theme asset)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify-hosted video (optional override)"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Hero MP4 URL (blank = theme asset)"
    }
  ],
  "presets": [{ "name": "Hygen hero" }]
}
{% endschema %}
