<section class="hygen-password">
  <div class="hygen-password__inner">
    <p class="hygen-password__brand">{{ shop.name | upcase | default: 'GUISED' }}</p>
    <h1 class="hygen-password__title">Opening soon</h1>
    <p class="hygen-password__lede">Enter the store password to continue.</p>

    {% form 'storefront_password', class: 'hygen-password__form' %}
      {% if form.errors %}
        <p class="hygen-password__error" role="alert">{{ form.errors | default_errors }}</p>
      {% endif %}
      <label class="hygen-sr-only" for="Password">Password</label>
      <input
        id="Password"
        class="hygen-password__input"
        type="password"
        name="password"
        placeholder="Password"
        autocomplete="current-password"
      >
      <button type="submit" class="hygen-password__submit">
        Enter
        <span aria-hidden="true"></span>
      </button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Hygen password",
  "tag": "section",
  "class": "hygen-section-password",
  "settings": [],
  "presets": [{ "name": "Hygen password" }]
}
{% endschema %}
