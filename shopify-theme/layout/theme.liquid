<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#000000">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&display=swap" rel="stylesheet">

    {{ 'hygen.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="hygen-body template-{{ template.name }}">
    <button
      type="button"
      class="hygen-burger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="hygen-menu"
      data-hygen-burger
    >
      <span class="hygen-burger__lines" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    <nav class="hygen-nav" aria-label="Primary" data-hygen-nav>
      <a href="#concept" data-nav-id="concept">Concept</a>
      <a href="#about" data-nav-id="about">About</a>
      <a href="#collection" data-nav-id="collection">Collection</a>
      <a href="#stockist" data-nav-id="stockist">Stockist</a>
      <a href="{{ pages.contact.url | default: '/pages/contact' }}">Contact</a>
      <a href="{{ routes.root_url }}" target="_blank" rel="noreferrer">Online Store</a>
    </nav>

    <div
      id="hygen-menu"
      class="hygen-menu"
      role="dialog"
      aria-modal="true"
      aria-label="Site menu"
      data-hygen-menu
    >
      <a href="#concept" class="hygen-menu__brand" data-hygen-menu-close>{{ shop.name | upcase }}</a>
      <nav class="hygen-menu__nav" aria-label="Menu">
        <a href="#concept" data-hygen-menu-close>Concept</a>
        <a href="#about" data-hygen-menu-close>About</a>
        <a href="#collection" data-hygen-menu-close>Collection</a>
        <a href="#stockist" data-hygen-menu-close>Stockist</a>
        <a href="{{ pages.contact.url | default: '/pages/contact' }}" data-hygen-menu-close>Contact</a>
        <a href="{{ routes.root_url }}" target="_blank" rel="noreferrer" data-hygen-menu-close>Online Store</a>
      </nav>
      <div class="hygen-menu__sns">
        {% if settings.social_instagram_link != blank %}
          <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noreferrer">IG</a>
        {% else %}
          <a href="https://www.instagram.com/" target="_blank" rel="noreferrer">IG</a>
        {% endif %}
        <a href="mailto:{{ shop.email }}">Mail</a>
      </div>
    </div>

    <main class="hygen-main" id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {{ 'hygen.js' | asset_url | script_tag }}
  </body>
</html>
