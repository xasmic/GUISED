<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#000000">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    {% # theme-check-disable RemoteAsset %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Cormorant+Garamond:wght@400;500;600&display=swap" rel="stylesheet">
    {% # theme-check-enable RemoteAsset %}

    {{ 'hygen.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="hygen-body template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <div class="hygen-chrome" data-hygen-chrome aria-hidden="true"></div>

    <header class="hygen-header">
      <nav class="hygen-nav" aria-label="Primary" data-hygen-nav>
        <a href="{{ pages['terms-of-service'].url | default: '/pages/terms-of-service' }}">Terms of Service</a>
        <a href="{{ pages.about.url | default: '/pages/about' }}">About</a>
        <a href="{{ pages.contact.url | default: '/pages/contact' }}">Contact</a>
        <a href="{{ pages.customs.url | default: '/pages/customs' }}">Customs</a>
        <a href="{{ pages.collaborations.url | default: '/pages/collaborations' }}">Collaborations</a>
        <a href="{{ routes.all_products_collection_url }}">Online Store</a>
      </nav>

      <a href="{{ routes.root_url }}" class="hygen-brand" aria-label="{{ shop.name | upcase }} home">
        <span>{{ shop.name | upcase | default: 'GUISED' }}</span>
      </a>

      <div class="hygen-header__end">
        <button
          type="button"
          class="hygen-burger"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="hygen-menu"
          data-hygen-burger
        >
          <span class="hygen-burger__lines" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>

        <div class="hygen-utils" data-hygen-utils>
          {% form 'localization', id: 'HygenLocalizationForm', class: 'hygen-localization-form' %}
            <input
              type="hidden"
              name="country_code"
              value="{{ localization.country.iso_code }}"
              data-hygen-country-code
            >
          {% endform %}

          <div class="hygen-currency" data-hygen-currency>
            <button
              type="button"
              class="hygen-utils__currency"
              aria-label="Country and currency: {{ localization.country.name }}, {{ localization.country.currency.iso_code }}"
              aria-expanded="false"
              aria-haspopup="listbox"
              data-hygen-currency-toggle
            >
              <span data-hygen-currency-code>{{ localization.country.currency.iso_code }}</span>
              <svg width="8" height="5" viewBox="0 0 8 5" fill="none" aria-hidden="true">
                <path d="M1 1L4 4L7 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
            <div class="hygen-currency__panel" hidden data-hygen-currency-panel>
              <div class="hygen-currency__search">
                <label class="hygen-currency__search-field">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="11" cy="11" r="6.25" stroke="currentColor" stroke-width="1.4"></circle>
                    <path d="M16.2 16.2L20.5 20.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
                  </svg>
                  <span class="hygen-sr-only">Search countries</span>
                  <input type="search" placeholder="Search" autocomplete="off" data-hygen-currency-filter>
                </label>
              </div>
              <ul class="hygen-currency__list" role="listbox" data-hygen-currency-list>
                {% for country in localization.available_countries %}
                  <li
                    data-hygen-country-option
                    data-search="{{ country.name | downcase }} {{ country.currency.iso_code | downcase }}"
                  >
                    <button
                      type="button"
                      role="option"
                      data-country-code="{{ country.iso_code }}"
                      data-country-name="{{ country.name | escape }}"
                      data-currency-code="{{ country.currency.iso_code }}"
                      aria-selected="{% if country.iso_code == localization.country.iso_code %}true{% else %}false{% endif %}"
                      {% if country.iso_code == localization.country.iso_code %}class="is-active"{% endif %}
                    >
                      <span>{{ country.name }}</span>
                      <span class="hygen-currency__option-code">{{ country.currency.iso_code }}</span>
                    </button>
                  </li>
                {% endfor %}
                <li class="hygen-currency__empty" hidden data-hygen-currency-empty>No matches</li>
              </ul>
            </div>
          </div>

          <div class="hygen-utils__search">
            <form
              class="hygen-utils__search-form"
              role="search"
              action="{{ routes.search_url }}"
              method="get"
              data-hygen-search-form
            >
              <label class="hygen-sr-only" for="hygen-search-input">Search</label>
              <input
                id="hygen-search-input"
                class="hygen-utils__search-input"
                type="search"
                name="q"
                placeholder="Search"
                autocomplete="off"
              >
            </form>
            <button
              type="button"
              class="hygen-utils__icon"
              aria-label="Search"
              aria-expanded="false"
              data-hygen-search-toggle
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="6.25" stroke="currentColor" stroke-width="1.4"></circle>
                <path d="M16.2 16.2L20.5 20.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
              </svg>
            </button>
          </div>

          <a href="{{ routes.account_url }}" class="hygen-utils__icon" aria-label="Account">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="8" r="3.25" stroke="currentColor" stroke-width="1.4"></circle>
              <path d="M5.5 19.5c1.4-3.2 3.7-4.75 6.5-4.75s5.1 1.55 6.5 4.75" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
            </svg>
          </a>

          <a href="{{ routes.cart_url }}" class="hygen-utils__icon hygen-utils__cart" aria-label="Bag">
            <svg width="17" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M7.5 8.5V7a4.5 4.5 0 0 1 9 0v1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
              <path d="M6 8.5h12l-.7 11.2a1.5 1.5 0 0 1-1.5 1.4H8.2a1.5 1.5 0 0 1-1.5-1.4L6 8.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
            </svg>
            <span
              class="hygen-utils__cart-count{% if cart.item_count == 0 %} is-empty{% endif %}"
              data-hygen-cart-count
              {% if cart.item_count == 0 %}hidden{% endif %}
            >{{ cart.item_count }}</span>
          </a>
        </div>
      </div>
    </header>

    <div class="hygen-menu" data-hygen-menu>
      <button
        type="button"
        class="hygen-menu__backdrop"
        aria-label="Close menu"
        data-hygen-menu-close
      ></button>
      <div
        id="hygen-menu"
        class="hygen-menu__panel"
        role="dialog"
        aria-modal="true"
        aria-label="Site menu"
      >
        <div class="hygen-menu__top">
          <a href="{{ routes.root_url }}" class="hygen-menu__brand" data-hygen-menu-close>{{ shop.name | upcase | default: 'GUISED' }}</a>
          <button
            type="button"
            class="hygen-menu__close"
            aria-label="Close menu"
            data-hygen-menu-close
          >
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
          </button>
        </div>
        <nav class="hygen-menu__nav" aria-label="Menu">
          <a href="{{ pages['terms-of-service'].url | default: '/pages/terms-of-service' }}" data-hygen-menu-close>Terms of Service</a>
          <a href="{{ pages.about.url | default: '/pages/about' }}" data-hygen-menu-close>About</a>
          <a href="{{ pages.contact.url | default: '/pages/contact' }}" data-hygen-menu-close>Contact</a>
          <a href="{{ pages.customs.url | default: '/pages/customs' }}" data-hygen-menu-close>Customs</a>
          <a href="{{ pages.collaborations.url | default: '/pages/collaborations' }}" data-hygen-menu-close>Collaborations</a>
          <a href="{{ routes.all_products_collection_url }}" data-hygen-menu-close>Online Store</a>
        </nav>
      </div>
    </div>

    <main class="hygen-main" id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% unless template.name == 'gift_card' %}
      {% unless template.suffix == 'contact' or template.suffix == 'customs' %}
        {% render 'hygen-footer' %}
      {% endunless %}
    {% endunless %}

    <script src="{{ 'hygen.js' | asset_url }}" defer></script>
  </body>
</html>
