{%- comment -%}
  Culatta / latest product grid fallback using theme assets on this store.
  Format: asset|title|href|fallback_price|sold_out
{%- endcomment -%}

{%- liquid
  assign contact_email = settings.custom_orders_email | strip
  if contact_email == blank
    assign contact_email = shop.email | strip
  endif
  if contact_email == blank
    assign contact_email = 'atelierguise@gmail.com'
  endif
-%}

{%- case preset -%}
  {%- when 'culatta' -%}
    {%- assign products = 'hygen-culatta-long-wallet.jpg|Culatta Long Wallet|/products/untitled-jan21_23-21|$470.00|false,hygen-forager-satchel-black.jpg|Forager Satchel|/products/forager-satchel-black|$760.00|false,hygen-girded-tote.jpg|Girded Tote|/products/untitled-jan12_14-09|$990.00|false,hygen-horse-culatta-bifold.jpg|Horse Culatta Bifold|/products/horse-culatta-bifold-wallet|$320.00|false' | split: ',' -%}
  {%- else -%}
    {%- assign products = 'hygen-girded-tote.jpg|Girded Tote|/products/untitled-jan12_14-09|$990.00|false,hygen-culatta-long-wallet.jpg|Culatta Long Wallet|/products/untitled-jan21_23-21|$470.00|false,hygen-forager-satchel-black.jpg|Forager Satchel|/products/forager-satchel-black|$760.00|false,hygen-horse-culatta-bifold.jpg|Horse Culatta Bifold|/products/horse-culatta-bifold-wallet|$320.00|false' | split: ',' -%}
{%- endcase -%}

{%- for item in products -%}
  {%- assign parts = item | split: '|' -%}
  {%- assign image_asset = parts[0] -%}
  {%- assign title = parts[1] -%}
  {%- assign href = parts[2] -%}
  {%- assign price = parts[3] -%}
  {%- assign sold_out = parts[4] -%}
  {%- assign product_handle = href | split: '/products/' | last | split: '?' | first -%}
  {%- assign shopify_product = all_products[product_handle] -%}
  {%- if shopify_product != blank -%}
    {%- assign sold_out = 'false' -%}
    {%- unless shopify_product.available -%}
      {%- assign sold_out = 'true' -%}
    {%- endunless -%}
  {%- endif -%}
  {%- capture notify_subject -%}Back in stock — {{ title }}{%- endcapture -%}
  <li class="hygen-collection__item{% if sold_out == 'true' %} is-sold-out{% endif %}">
    <a class="hygen-collection__link" href="{{ href }}">
      <div class="hygen-collection__media">
        <img
          class="hygen-collection__img"
          src="{{ image_asset | asset_img_url: '600x' }}"
          srcset="
            {{- image_asset | asset_img_url: '400x' }} 400w,
            {{- image_asset | asset_img_url: '600x' }} 600w,
            {{- image_asset | asset_img_url: '800x' }} 800w
          "
          sizes="(min-width: 1320px) 18vw, (min-width: 1100px) 28vw, (min-width: 600px) 40vw, 85vw"
          alt="{{ title | escape }}"
          loading="lazy"
          width="600"
          height="750"
        >
        {% if sold_out == 'true' %}
          <span class="hygen-collection__badge">Sold out</span>
        {% endif %}
      </div>
      <p class="hygen-collection__name">{{ title }}</p>
      <p class="hygen-collection__price">
        {% if sold_out == 'true' %}
          <span class="hygen-collection__soldout">Sold out</span>
        {% elsif shopify_product != blank %}
          {{ shopify_product.price | money }}
        {% else %}
          {{ price }}
        {% endif %}
      </p>
    </a>
    {% if sold_out == 'true' %}
      <a
        class="hygen-collection__notify"
        href="mailto:{{ contact_email }}?subject={{ notify_subject | url_encode }}"
      >
        Email us
      </a>
    {% endif %}
  </li>
{%- endfor -%}
