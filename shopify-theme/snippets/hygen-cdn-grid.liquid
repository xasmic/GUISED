{%- comment -%}
  Culatta / latest product grid fallback using theme assets on this store.
  Format: asset|title|href|price|sold_out
{%- endcomment -%}

{%- liquid
  assign contact_email = shop.email | default: 'info@atelierguised.com'
-%}

{%- case preset -%}
  {%- when 'culatta' -%}
    {%- assign products = 'hygen-culatta-long-wallet.jpg|Culatta Long Wallet|/products/culatta-long-wallet|$420.00|false,hygen-forager-satchel-black.jpg|Forager Satchel (Black)|/products/forager-satchel-black|$760.00|false,hygen-forager-satchel-dirty-white.jpg|Forager Satchel (Dirty White)|/products/forager-satchel-dirty-white|$760.00|true,hygen-girded-tote.jpg|Girded Tote|/products/girded-tote|$990.00|false,hygen-horse-culatta-bifold.jpg|Horse Culatta Bifold|/products/horse-culatta-bifold|$290.00|false' | split: ',' -%}
  {%- else -%}
    {%- assign products = 'hygen-girded-tote.jpg|Girded Tote|/products/girded-tote|$990.00|false,hygen-culatta-long-wallet.jpg|Culatta Long Wallet|/products/culatta-long-wallet|$420.00|false,hygen-forager-satchel-black.jpg|Forager Satchel (Black)|/products/forager-satchel-black|$760.00|false,hygen-forager-satchel-dirty-white.jpg|Forager Satchel (Dirty White)|/products/forager-satchel-dirty-white|$760.00|true,hygen-horse-culatta-bifold.jpg|Horse Culatta Bifold|/products/horse-culatta-bifold|$290.00|false' | split: ',' -%}
{%- endcase -%}

{%- for item in products -%}
  {%- assign parts = item | split: '|' -%}
  {%- assign image_asset = parts[0] -%}
  {%- assign title = parts[1] -%}
  {%- assign href = parts[2] -%}
  {%- assign price = parts[3] -%}
  {%- assign sold_out = parts[4] -%}
  {%- capture notify_subject -%}Back in stock — {{ title }}{%- endcapture -%}
  <li class="hygen-collection__item{% if sold_out == 'true' %} is-sold-out{% endif %}">
    <a class="hygen-collection__link" href="{{ href }}">
      <div class="hygen-collection__media">
        <img
          class="hygen-collection__img"
          src="{{ image_asset | asset_url }}"
          alt="{{ title | escape }}"
          loading="lazy"
          width="600"
          height="750"
        >
        {% if sold_out == 'true' %}
          <span class="hygen-collection__badge">Sold out</span>
        {% endif %}
      </div>
      <p class="hygen-collection__name">{{ title }}</p>
      <p class="hygen-collection__price">
        {% if sold_out == 'true' %}
          <span class="hygen-collection__soldout">Sold out</span>
        {% else %}
          {{ price }}
        {% endif %}
      </p>
    </a>
    {% if sold_out == 'true' %}
      <a
        class="hygen-collection__notify"
        href="mailto:{{ contact_email }}?subject={{ notify_subject | url_encode }}"
      >
        Email us
      </a>
    {% endif %}
  </li>
{%- endfor -%}
