{%- comment -%}
  Brand values strip — rendered above the footer on every page.
{%- endcomment -%}

<section class="hygen-values" aria-label="Brand values">
  <div class="hygen-values__inner">
    <div class="hygen-values__item">
      <h2 class="hygen-values__title">Handcrafted with intention</h2>
      <p class="hygen-values__body">
        Every piece is entirely handmade. Cut, stitched, and finished by hand.
      </p>
    </div>
    <div class="hygen-values__item">
      <h2 class="hygen-values__title">Ethically sourced materials</h2>
      <p class="hygen-values__body">
        We work exclusively with ethically sourced leathers from trusted tanneries overseas. Every hide is chosen for its raw character, texture, and the stories within its scars.
      </p>
    </div>
    <div class="hygen-values__item">
      <h2 class="hygen-values__title">Built to endure</h2>
      <p class="hygen-values__body">
        Our pieces are made to age gracefully, designed to accompany you through time.
      </p>
    </div>
  </div>
</section>
