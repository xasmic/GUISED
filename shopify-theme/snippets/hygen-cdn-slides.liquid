{%- if mode == 'slides' -%}
  {%- for item in slides -%}
    {%- assign parts = item | split: '|' -%}
    {%- liquid
      assign slide_href = parts[2] | strip
      if slide_href contains '/products/'
        assign slide_handle = slide_href | split: '/products/' | last | split: '?' | first
        assign slide_product = all_products[slide_handle]
        if slide_product != blank
          assign slide_href = slide_product.url
        else
          assign slide_href = routes.all_products_collection_url
        endif
      elsif slide_href contains '/collections/'
        assign slide_handle = slide_href | split: '/collections/' | last | split: '?' | first
        if slide_handle == 'all'
          assign slide_href = routes.all_products_collection_url
        else
          assign slide_collection = collections[slide_handle]
          if slide_collection != blank
            assign slide_href = slide_collection.url
          else
            assign slide_href = routes.all_products_collection_url
          endif
        endif
      endif
    -%}
    <div class="hygen-slide{% if forloop.first %} is-active{% endif %}">
      <a href="{{ slide_href }}">
        <img src="{{ parts[0] }}" alt="{{ parts[1] | escape }}" loading="lazy" width="600" height="800">
      </a>
    </div>
  {%- endfor -%}
{%- elsif mode == 'thumbs' -%}
  {%- for item in slides -%}
    {%- assign parts = item | split: '|' -%}
    <button
      type="button"
      class="hygen-modal__thumb"
      data-hygen-thumb
      data-season="{{ season_index }}"
      data-slide="{{ forloop.index0 }}"
    >
      <img src="{{ parts[0] }}" alt="{{ parts[1] | escape }}" loading="lazy" width="120" height="160">
    </button>
  {%- endfor -%}
{%- endif -%}
